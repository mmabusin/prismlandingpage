{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "browser=(), camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/refractions",
      "destination": "https://app.theprismai.com/_refractions"
    },
    {
      "source": "/refractions/:path*",
      "destination": "https://app.theprismai.com/_refractions/:path*"
    },
    {
      "source": "/rankings",
      "destination": "https://app.theprismai.com/_rankings"
    },
    {
      "source": "/rankings/:path*",
      "destination": "https://app.theprismai.com/_rankings/:path*"
    },
    {
      "source": "/pricing",
      "destination": "https://app.theprismai.com/_pricing"
    }
  ]
}
